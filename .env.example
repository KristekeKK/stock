# Copy this file to ".env" and fill in your real values.
# NEVER commit the real .env file.

# --- OANDA credentials ---
# Get these from https://www.oanda.com (create a DEMO account first).
# fxTrade Practice (demo): https://www.oanda.com/demo-account/tpa/personal_token
OANDA_API_TOKEN=your_api_token_here
OANDA_ACCOUNT_ID=your_account_id_here

# --- Environment ---
# "practice" = demo (fake money).  "live" = real money.
# Keep this on "practice" until the bot has proven itself.
OANDA_ENV=practice

# --- Trading config ---
INSTRUMENT=EUR_USD
GRANULARITY=H1

# --- Survival / risk config ---
START_CAPITAL=10
DEATH_FLOOR_PCT=20
RISK_PER_TRADE_PCT=1
DAILY_MAX_LOSSES=3

# --- Strategy config ---
FAST_MA=10
SLOW_MA=30
TREND_MA=100
ATR_PERIOD=14
ATR_STOP_MULT=2.0

# --- Master safety switch ---
# false = dry run (log intended trades, place NOTHING).
# true  = actually send orders to whichever OANDA_ENV is set above.
LIVE=false
